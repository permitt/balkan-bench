{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://balkanbench.com/schemas/model_spec.json",
  "title": "BalkanBench Model Specification",
  "type": "object",
  "required": ["name", "family", "params_hint"],
  "additionalProperties": false,
  "properties": {
    "name":         { "type": "string", "minLength": 1 },
    "hf_repo":      { "type": "string", "minLength": 1 },
    "hf_revision":  { "type": "string" },
    "tokenizer_repo": {
      "type": "string",
      "minLength": 1,
      "description": "HF repo to load the tokenizer from when it differs from hf_repo (e.g. base-model tokenizer for repos shipping only slow sentencepiece files transformers 5.x cannot load)."
    },
    "family":       { "type": "string", "minLength": 1 },
    "params_hint":  { "type": "string", "minLength": 1 },
    "tier":         { "type": "string", "enum": ["official", "experimental"] },
    "access":       { "type": "string", "enum": ["open_weights", "api"], "default": "open_weights" },
    "provider":     { "type": "string", "enum": ["anthropic", "openai", "gemini"] },
    "api_model_id": { "type": "string", "minLength": 1 },
    "hf_auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "required": { "type": "boolean" } }
    },
    "training": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "learning_rate": { "type": "number", "exclusiveMinimum": 0 },
        "batch_size":    { "type": "integer", "minimum": 1 },
        "num_epochs":    { "type": "integer", "minimum": 1 },
        "fp16":          { "type": "boolean" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature":    { "type": "number", "minimum": 0 },
        "max_tokens":     { "type": "integer", "minimum": 1 },
        "batch_size":     { "type": "integer", "minimum": 1 },
        "dtype":          { "type": "string" },
        "concurrency":    { "type": "integer", "minimum": 1 },
        "device_map": {
          "type": "string",
          "enum": ["auto"],
          "description": "When set to 'auto', accelerate shards the model across all visible devices (e.g. 8x L4 on one Vertex machine) instead of loading onto a single device."
        }
      }
    },
    "task_overrides": {
      "type": "object",
      "description": "Per-task training overrides. Keys must be namespaced {benchmark}.{task} to avoid collisions across benchmarks.",
      "patternProperties": {
        "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "seeds": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": { "properties": { "access": { "const": "api" } }, "required": ["access"] },
      "then": { "required": ["provider", "api_model_id"] },
      "else": { "required": ["hf_repo"] }
    }
  ]
}
